@model IEnumerable<GetAllDepartmentDTO>
@{
    ViewData["Title"] = "Index";
}

<h1 class="m-2">All Departments</h1>
<br />
<a class="btn btn-primary m-2" asp-controller="Department" asp-action="Create">Create Department</a>
@if (Model.Any())
{
    <table class="table table-striped  table-hover">
        <thead class="text-center">
            <tr>
                <th>@Html.DisplayNameFor(prop => prop.Code)</th>
                <th>@Html.DisplayNameFor(prop => prop.Name)</th>
                <th>@Html.DisplayNameFor(prop => prop.Description)</th>
                <th>@Html.DisplayNameFor(prop => prop.DateOfCreated)</th>
                <th>Details</th>
                <th>Edit</th>
                <th>Delete</th>
            </tr>
        </thead>

        <tbody class="text-center">
            @foreach (var dept in Model)
            {
                <tr>
                    <td>@dept.Code</td>
                    <td>@dept.Name</td>
                    <td>@dept.Description</td>
                    <td>@dept.DateOfCreated</td>
                    <td><a class="btn btn-primary" asp-controller="department" asp-action="details" asp-route-id="@dept.Id"><i class="fa-solid fa-eye"></i>Details</a></td>
                    <td><a class="btn btn-success" asp-controller="department" asp-action="Edit" asp-route-id="@dept.Id"><i class="fa-solid fa-pen-to-square"></i>Edit</a></td>
                    @* <td><a class="btn btn-danger" asp-controller="department" asp-action="Delete" asp-route-id="@dept.ID"><i class="fa-solid fa-trash"></i>Delete</a></td> *@
                    <td>
                        <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#DeleteModal-@dept.Id">
                            <i class="fas fa-trash"></i> Delete
                        </button>
                        <div class="modal fade" id="DeleteModal-@dept.Id" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h1 class="modal-title fs-5" id="exampleModalLabel">Delete Department</h1>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        Are You Sure to Delete this Department?
                                    </div>
                                    <div class="modal-footer">
                                        <form asp-action="Delete" asp-controller="Department" asp-route-id="@dept.Id" class="mt-4">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                            <input type="submit" value="Delete" class="btn btn-danger" />
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info m-2 p-4">
        <h2>No Department Found !!</h2>
    </div>
}



