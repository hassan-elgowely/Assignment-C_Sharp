@model IEnumerable<DepartmentGetAllDTO>
@{
    ViewData["Title"] = "Index";
}

<h1 class="my-3">All Departments</h1>
<br/>
<a asp-controller="Department" asp-action="Create" class="btn btn-primary m-3">Create Department</a>

@if (Model.Any())
{
    <table class="table table-striped table-hover">
        <thead class="text-center">
            <tr>
                <th>@Html.DisplayNameFor(prop => prop.Code)</th>
                <th>@Html.DisplayNameFor(prop => prop.Name)</th>
                <th>@Html.DisplayNameFor(prop => prop.Description)</th>
                <th>@Html.DisplayNameFor(prop => prop.DateofCreation)</th>
                <th>Details</th>
                <th>Edit</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody class="text-center"" > 
            @foreach (var dept in Model)
            {
                <tr>
                    <td>@dept.Code</td>
                    <td>@dept.Name</td>
                    <td>@dept.Description</td>
                    <td>@dept.DateofCreation</td>
                    <td><a class="btn btn-primary m-1" asp-action="Details" asp-controller="Department" asp-route-Id="@dept.DeptId"><i class="fa-solid fa-eye"></i> Details</a></td>
                    <td><a class="btn btn-warning m-1" asp-action="Edit" asp-controller="Department" asp-route-Id="@dept.DeptId"><i class="fa-solid fa-pen-to-square"></i> Edit</a></td>
                    <td><a class="btn btn-danger m-1" asp-action="Edit" asp-controller="Department" asp-route-Id="@dept.DeptId"><i class="fa-solid fa-trash"></i> Delete</a></td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info m-5 p-4">
        <h2>No Department Found !!</h2>
    </div>
}